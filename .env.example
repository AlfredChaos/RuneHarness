OPENAI_API_KEY=sk-your-key-here
# OpenAI 兼容端点；官方 API 可留空
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
# 开启后向 agent loop 注入 task 工具（子代理委派）
#RUNE_SUBAGENT=true
# 开启后子代理也可再 spawn 一层子代理（仅一层，多层嵌套暂不支持）
#RUNE_SUBAGENT_NEST=true
# 上下文压缩：工作窗口上限（显式值 > 内置模型表 > 默认 200000；语义是
# 你愿意让 agent 用多少，不是模型真实窗口——可故意配小以控制成本）、
# 端点单次输出上限（默认 8192）、强制压缩开关（默认 on；off 时提醒、
# /compact 与模型 compact 工具仍生效）
#RUNE_CONTEXT_TOKENS=200000
#RUNE_MAX_OUTPUT_TOKENS=8192
#RUNE_AUTOCOMPACT=on
